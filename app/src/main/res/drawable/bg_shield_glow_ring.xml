<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1000E676" />
            <stroke android:width="2dp" android:color="#4000E676" />
            <size android:width="170dp" android:height="170dp" />
        </shape>
    </item>
    <!-- Middle ring -->
    <item android:top="16dp" android:left="16dp" android:right="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="#2000E676" />
            <stroke android:width="3dp" android:color="#8000E676" />
        </shape>
    </item>
    <!-- Inner ring -->
    <item android:top="30dp" android:left="30dp" android:right="30dp" android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="#0B2B1B" />
            <stroke android:width="3.5dp" android:color="#00E676" />
        </shape>
    </item>
</layer-list>
